{
  "name": "coldspot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100 --turbopack",
    "build": "next build --turbopack",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
