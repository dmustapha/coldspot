    "c3:integrity": "tsx scripts/c3-integrity.ts",
    "hero:prerun": "tsx scripts/hero-prerun.ts"
  },
  "dependencies": {
    "next": "^15.5.4",
    "openai": "^4.77.0",
    "oracledb": "^6.7.0",
