# COLDSPOT env — copy to .env.local and fill. NEVER commit real secrets.

# --- App / deploy ---
# Absolute base URL of the deployment. metadataBase reads this so og:image / twitter:image
# resolve to the live host. Leave unset locally to default to the production URL.
NEXT_PUBLIC_SITE_URL=https://coldspot-agent.duckdns.org
# Set to 1 ONLY on an app-only (no-Zetaris) deploy: the console surfaces then signpost the earned
# replay instead of firing a live resolve that would fail closed. Leave unset for full live behavior.
NEXT_PUBLIC_REPLAY_MODE=

# --- NVIDIA NIM (Nemotron reasoning + vision) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Per-request Nemotron client timeout in ms (default 90000).
NEMOTRON_TIMEOUT_MS=90000

# --- Zetaris (federation) ---
# Local Docker path: ZETARIS_BASE=http://localhost:8888 + login flow (USER/PASSWORD).
# Cloud path: ZETARIS_BASE=<cloud-url> + ZETARIS_API_KEY (the key IS the bearer).
ZETARIS_BASE=http://localhost:8888
ZETARIS_ORG_ID=1
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=
ZETARIS_API_KEY=
# Per-request Zetaris client timeout in ms (default 60000).
ZETARIS_TIMEOUT_MS=60000
# Federated policy source handle (default FILES.policy).
POLICY_SOURCE=FILES.policy

# --- Oracle ADB (TYPE 1 source + Trust Ledger mirror) ---
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=coldspot_tp
ORACLE_WALLET_DIR=
# THIN-mode mTLS needs the wallet PEM passphrase (the password set when the
# wallet was downloaded) — configDir-only SSO stalls on this ADB.
ORACLE_WALLET_PASSWORD=
TNS_ADMIN=
ORACLE_JDBC_URL=
# How Zetaris registers the policy source: "filestore" (default, CSV via POLICY_CSV_PATH) or "jdbc".
ORACLE_DATASOURCE_MODE=filestore
# Path to the policy CSV when ORACLE_DATASOURCE_MODE=filestore (the Zetaris filestore mount path).
POLICY_CSV_PATH=/home/zetaris/customer-data/shared/policy.csv

# --- Treaty API (TYPE 3, self-authored, seeded with real NOAA CAT dates) ---
# Local build: the in-app /api/treaty endpoint. At deploy: <deployed-base>/api/treaty.
TREATY_API_URL=http://localhost:3000/api/treaty

# --- Filestore CSV (TYPE 2, PDF-extracted endorsement rows) ---
ENDORSEMENT_CSV_PATH=./data/seed/endorsements.csv

# --- Trust Ledger (Meterless H-MEM JSONL mirror) ---
LEDGER_DIR=./evidence/ledger
